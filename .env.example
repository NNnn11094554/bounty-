# ── Backend (backend/.env или переменные окружения Render) ─────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://meowgul:meowgul@localhost:5432/meowgul
# Токен бота от @BotFather. В development можно не задавать — будет тестовый.
BOT_TOKEN=
# Username бота без @ и короткое имя Mini App из /newapp — для реферальных ссылок t.me/<bot>/<app>
BOT_USERNAME=meowgul_game_bot
MINIAPP_SHORT_NAME=app
# Публичные адреса фронтенда и API (https в продакшене)
WEBAPP_URL=http://localhost:5173
API_URL=http://localhost:3000
# Через запятую, если фронтенд доступен с нескольких доменов (по умолчанию = WEBAPP_URL)
CORS_ORIGINS=
# Telegram ID администраторов через запятую (доступ к /admin)
ADMIN_TELEGRAM_IDS=
# Режим разработчика (все скины, карточки без условий) — только этот Telegram ID; пусто — единственный админ
DEVELOPER_TELEGRAM_ID=
# Канал для задания «Подписаться»: @username или -100…; бот должен быть администратором канала
CHANNEL_ID=
CHANNEL_URL=
# Час сброса ежедневных активностей по UTC (16 = 19:00 по Киеву летом)
DAILY_RESET_UTC_HOUR=16
# Секрет вебхука бота (если пусто — вычисляется из BOT_TOKEN)
WEBHOOK_SECRET=
# Включить бота (webhook в production, long polling в development)
BOT_ENABLED=false
LOG_LEVEL=info

# ── Frontend (frontend/.env или переменные Static Site на Render) ──────────
# Адрес API. В разработке пусто — запросы идут через прокси Vite на localhost:3000
VITE_API_URL=
# Адрес игры при сборке: рядом с ней создаётся tonconnect-manifest.json (на Render — RENDER_EXTERNAL_URL сам)
VITE_WEBAPP_URL=
# Свой адрес манифеста TON Connect (TONCONNECT_MANIFEST_URL из ТЗ); пусто — манифест рядом с игрой или из API
VITE_TONCONNECT_MANIFEST_URL=
# Для кнопки «Открыть в Telegram» на экране вне Telegram
VITE_BOT_USERNAME=meowgul_game_bot
VITE_MINIAPP_SHORT_NAME=app
# Сайт (/site/): ссылки появляются, когда заданы; пусто — X и Community показаны как «Скоро»,
# «Стать партнёром» ведёт в Telegram-бота
VITE_X_URL=
VITE_COMMUNITY_URL=
VITE_PARTNER_URL=
