# Скопируйте в .env и заполните. Файл .env НЕ коммитить (он в .gitignore).

# --- OKX API ---
# Ключ: только право «Trade» (без «Withdraw»!), с привязкой к IP сервера.
# Для DEMO ключ создаётся в режиме демо-торговли OKX (Trade → Demo trading → API).
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- Режим ---
# По умолчанию DEMO (заголовок x-simulated-trading: 1).
# Реальная торговля включается ТОЛЬКО строкой LIVE_TRADING=true (и ключом от реального счёта).
LIVE_TRADING=false

# --- Telegram ---
# Токен от @BotFather и ваш chat_id (узнать: @userinfobot). Бот отвечает только этому chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Путь к файлу с торговыми параметрами (необязательно)
CONFIG_PATH=config.yaml
